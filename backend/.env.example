# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://readquest:readquest_dev_pw@127.0.0.1:5432/readquest

# Separate database used only by the backend test suite — never point this
# at a production database.
TEST_DATABASE_URL=postgresql+psycopg2://readquest:readquest_dev_pw@127.0.0.1:5432/readquest_test

# Origin of the Vite dev server, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign JWTs. Generate a real random value for anything
# beyond local development — never reuse the placeholder below.
JWT_SECRET=change-me-to-a-long-random-string

# Base URL this API is served from (used in generated links, docs, etc.)
API_BASE_URL=http://localhost:8000

# Phase 8 Step 2 — AI service selection.
#   mock  (default) — MockAIAnalysisService + MockSpeechToTextService.
#         No external dependencies. Safe for CI/tests/offline dev.
#   real            — RealAIAnalysisService + RealSpeechToTextService
#         (Whisper). Requires the openai-whisper package + ffmpeg —
#         see backend/README.md "Phase 8 Step 2" before switching this.
AI_MODE=mock

# Whisper model size, used only when AI_MODE=real. One of:
# tiny / base / small / medium / large. Bigger = more accurate, slower,
# more memory. "base" is a reasonable default for a laptop/dev machine.
WHISPER_MODEL_SIZE=base

# Reject audio uploads larger than this (megabytes) before reading them
# into memory, on POST /api/speech/transcribe and
# POST /api/reading/session-audio.
MAX_AUDIO_UPLOAD_MB=15
